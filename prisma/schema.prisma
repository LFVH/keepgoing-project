generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  linhasDiario LinhasDiario[]
  refreshToken RefreshToken?
  treinos      Treino[]
  premium      Boolean?
  dtIniPremium DateTime?
  dtFimPremium DateTime?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id            Int      @id @default(autoincrement())
  expiresIn     Int
  user          Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate:   Cascade)
  userId        String   @unique
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Exercicio {
  id             Int      @id @default(autoincrement())
  nome           String   @unique
  execucoesPlano ExecucaoPlano[]
  execucoesReal  ExecucaoReal[]
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model Treino {
  id              Int      @id @default(autoincrement())
  nome            String
  comentarioGeral String?
  corCalendario   String?   
  linhasDiario    LinhasDiario[]
  execucoes       ExecucaoPlano[]
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId       String
  ordem           Int?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model LinhasDiario {
  id               Int      @id @default(autoincrement())
  data             DateTime
  pesoCorporal     Decimal? @db.Decimal(6, 2)
  comentarioGeral  String?
  execucoes        ExecucaoReal[]
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId        String
  treino           Treino?   @relation(fields: [treinoId], references: [id])
  treinoId         Int?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model ExecucaoPlano {
  id                 Int      @id @default(autoincrement())
  reps               Int?
  sets               Int?
  carga              Decimal? @db.Decimal(6, 2)
  tempo              Int?
  ordem              Int?
  comentarioExecucao String?
  exercicio          Exercicio @relation(fields: [exercicioId], references: [id])
  exercicioId        Int
  treino             Treino   @relation(fields: [treinoId], references: [id],onDelete: Cascade)
  treinoId           Int
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

model ExecucaoReal {
  id                  Int      @id @default(autoincrement())
  reps                Int?
  sets                Int?
  carga               Decimal? @db.Decimal(6, 2)
  tempo               Int?
  comentarioExecucao  String?
  percepcao           String?
  exercicio           Exercicio @relation(fields: [exercicioId], references: [id])
  exercicioId         Int
  diario              LinhasDiario @relation(fields: [diarioId], references: [id],onDelete: Cascade)
  diarioId            Int
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}